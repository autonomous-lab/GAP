<!--
  ClickHouse system-log control

  By default ClickHouse writes internal system logs (query_log,
  query_thread_log, part_log, trace_log, metric_log, ...) which grow
  without bound. The node's audit spine is GAP's own log, so these are
  redundant here.

  Disabling is done with remove="1", which deletes the whole section
  from the merged config. Overriding <engine> instead does NOT work:
  the default config already sets partition_by for these tables, and
  ClickHouse refuses the combination with
    Code: 36 ... PARTITION BY parameters should be specified directly
    inside 'engine' and 'partition_by' setting doesn't make sense
  which is exactly how this file kept the server from starting.

  Mounted at /etc/clickhouse-server/config.d/system-logs.xml in the
  compose file; ClickHouse merges it into the main config at startup.
-->
<clickhouse>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <session_log remove="1"/>

    <!-- Keep the error log, but bound it: 7 days, then purged. Only the
         TTL is overridden, so the default engine and partitioning stay
         consistent. -->
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
</clickhouse>
