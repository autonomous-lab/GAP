{
	email {$CADDY_ACME_EMAIL}
	admin 127.0.0.1:2019
	# GAP's own Cloudflare-facing name uses the mounted Elestio origin
	# certificate. Customer hostnames still opt into TLS explicitly below.
	auto_https disable_certs

	on_demand_tls {
		ask http://172.17.0.1:8080/internal/tls/ask?token={$GAP_CADDY_ASK_TOKEN}
	}
}

# GAP's own names use the mounted origin certificate and can never be mistaken
# for tenant hosts, even if a client supplies the internal marker header.
gap.geta.team, gap-node-01-u3.vm.elestio.app {
	tls /certs/fullchain.cer /certs/vm.elestio.app.key
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 172.17.0.1:8080 {
		header_up Host {host}
		header_up -X-GAP-Custom-Domain
	}
}

# Every other SNI name is admitted only after GAP's `ask` endpoint confirms a
# verified active mapping. No Caddy reload is needed when domains are added.
https:// {
	tls {
		on_demand
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 172.17.0.1:8080 {
		header_up Host {host}
		header_up X-GAP-Custom-Domain "1"
	}
}
