{
	email {$CADDY_ACME_EMAIL}
	admin 127.0.0.1:2019
	# GAP's own Cloudflare-facing name uses the mounted Elestio origin
	# certificate. Customer hostnames still opt into TLS explicitly below.
	auto_https disable_certs

	on_demand_tls {
		ask http://172.17.0.1:8080/internal/tls/ask?token={$GAP_CADDY_ASK_TOKEN}
	}
}

# Cloudflare "Flexible" terminates visitor TLS at its edge, then reaches the
# origin over HTTP while preserving the original scheme in CF-Visitor.
# Honour that signal only when the TCP peer belongs to an official Cloudflare
# range; a direct client cannot bypass HTTPS by spoofing the header.
http:// {
	route {
		@internal path /internal/*
		respond @internal 404

		@cloudflare_gap_https {
			host gap.geta.team gap-node-01-u3.vm.elestio.app
			header_regexp CF-Visitor (?i)"scheme"\s*:\s*"https"
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
		reverse_proxy @cloudflare_gap_https 172.17.0.1:8080 {
			header_up Host {host}
			header_up -X-GAP-Custom-Domain
		}

		@cloudflare_custom_https {
			header_regexp CF-Visitor (?i)"scheme"\s*:\s*"https"
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
		reverse_proxy @cloudflare_custom_https 172.17.0.1:8080 {
			header_up Host {host}
			header_up X-GAP-Custom-Domain "1"
		}

		redir https://{host}{uri} permanent
	}
}

# GAP's own names use the mounted origin certificate and can never be mistaken
# for tenant hosts, even if a client supplies the internal marker header.
gap.geta.team, gap-node-01-u3.vm.elestio.app {
	tls /certs/fullchain.cer /certs/vm.elestio.app.key
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 172.17.0.1:8080 {
		header_up Host {host}
		header_up -X-GAP-Custom-Domain
	}
}

# Every other SNI name is admitted only after GAP's `ask` endpoint confirms a
# verified active mapping. No Caddy reload is needed when domains are added.
https:// {
	tls {
		on_demand
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 172.17.0.1:8080 {
		header_up Host {host}
		header_up X-GAP-Custom-Domain "1"
	}
}
