# Refresh worker Python code without rebuilding the pinned QEMU/Rust binaries.
ARG BASE_IMAGE=gap-compose-fast-snapshot:rust
FROM ${BASE_IMAGE}
COPY runtime/compose/*.py /opt/runner/
COPY runtime/free_vm/gateway.py /opt/runner/free_vm_gateway.py
COPY runtime/free_vm/proxy.py /opt/runner/free_vm_proxy.py
COPY runtime/free_vm/proxy_manager.py /opt/runner/free_vm_proxy_manager.py
